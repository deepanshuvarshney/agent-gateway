# Copy to .env for local runs. No key is required: the mock provider is the default.

GATEWAY_ENV=local
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_DATABASE_URL=sqlite:///./data/gateway.db
# GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_EMBEDDINGS=hash
GATEWAY_OTEL_EXPORTER=none
# GATEWAY_OTEL_EXPORTER=otlp
# GATEWAY_OTEL_ENDPOINT=http://localhost:4318/v1/traces
GATEWAY_DEFAULT_POLICY=cost
GATEWAY_BOOTSTRAP_API_KEY=gw_demo_public
GATEWAY_ADMIN_API_KEY=gw_admin_dev
GATEWAY_ENABLE_MOCK=true

# Optional real providers. Leave unset in CI and on the free Render deploy.
# GATEWAY_GROQ_API_KEY=
# GATEWAY_GEMINI_API_KEY=
# GATEWAY_OLLAMA_BASE_URL=http://localhost:11434
